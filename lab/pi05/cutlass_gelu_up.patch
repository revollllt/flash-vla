+// C is the already BF16-rounded gate matrix. Preserve the BF16 up store
+// numerically before the exact GELU/product expression in fused_backbone.cu.
+class RoundedGeluMul : public Epilogue {
+ public:
+  using Epilogue::Epilogue;
+  using Epilogue::operator();
+  // As in CUTLASS LinearCombinationGELU, avoid unrolling the large epilogue.
+  static bool constexpr kIsHeavy = true;
+
+  CUTLASS_HOST_DEVICE bool is_source_needed() const { return true; }
+
+  CUTLASS_DEVICE FragmentOutput operator()(
+      FragmentAccumulator const& accumulator, FragmentSource const& source) const {
+    cutlass::NumericArrayConverter<Element, float, kCount> round_bf16;
+    cutlass::NumericArrayConverter<float, Element, kCount> to_float;
+    const FragmentCompute up = to_float(round_bf16(accumulator));
+    const FragmentCompute gate = to_float(source);
+    FragmentCompute result;
+    CUTLASS_PRAGMA_UNROLL
+    for (int i = 0; i < kCount; ++i) {
+      const float x = gate[i];
+      const float activation =
+          0.5f * x * (1.f + tanhf(0.7978845608028654f * (x + 0.044715f * x * x * x)));
+      result[i] = activation * up[i];
+    }
+    return round_bf16(result);
+  }
+};
