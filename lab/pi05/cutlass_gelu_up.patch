+extern "C" int32_t backbone_gelu_up_plan(
+    int32_t m, int32_t k, int32_t n, const void* a, const void* b,
+    const void* gate, void* output, void* workspace, void* stream, void** handle) {
+  const auto args = gelu_up_arguments(m, k, n, a, b, gate, output);
+  cutlass::Status status = GeluUpGemm::can_implement(args);
+  if (status != cutlass::Status::kSuccess)
+    return kCutlassError + static_cast<int32_t>(status);
+  auto* plan = new GeluUpGemm;
+  status = plan->initialize(args, workspace, static_cast<cudaStream_t>(stream));
+  if (status != cutlass::Status::kSuccess) {
+    delete plan;
+    return kCutlassError + static_cast<int32_t>(status);
+  }
+  *handle = plan;
+  return 0;
+}
+
+extern "C" int32_t backbone_gelu_up_run(void* handle, void* stream) {
+  const cutlass::Status status =
+      static_cast<GeluUpGemm*>(handle)->run(static_cast<cudaStream_t>(stream));
+  if (status != cutlass::Status::kSuccess)
+    return kCutlassError + static_cast<int32_t>(status);
+  return static_cast<int32_t>(cudaGetLastError());
+}
