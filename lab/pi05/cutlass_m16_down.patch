+// Fixed lab candidate: halve only cfg9's CTA/warp M, keeping its pipeline
+// and BF16-rounded gated residual. The shipped down and out-proj keep DownGemm.
+using M16DownDefaults = cutlass::gemm::device::GemmUniversalStreamkWithBroadcast<
+    Element, RowMajor, Element, RowMajor, Element, RowMajor, float,
+    cutlass::arch::OpClassTensorOp, cutlass::arch::Sm80,
+    cutlass::gemm::GemmShape<16, 64, 32>,
+    cutlass::gemm::GemmShape<16, 32, 32>,
+    cutlass::gemm::GemmShape<16, 8, 16>, RoundedGatedResidual,
+    cutlass::gemm::threadblock::ThreadblockSwizzleStreamK, 8, 8, 8>;
+
+using M16DownEpilogueBase = M16DownDefaults::GemmKernel::Epilogue;
+
+// The M16 tile still has two accumulator fragments. Retain the same
+// Target-local destination advance as DownEpilogue; do not change the vendor.
+class M16DownEpilogue : public M16DownEpilogueBase {
+ public:
+  using M16DownEpilogueBase::M16DownEpilogueBase;
+
+  CUTLASS_DEVICE void reduce(
+      int peer_begin, int peer_end, int fragment, void* workspace,
+      OutputOp const& op, ElementVector const* gate,
+      OutputTileIterator destination, OutputTileIterator source,
+      TensorTileIterator tensor, cutlass::MatrixCoord const& problem,
+      cutlass::MatrixCoord const& offset) {
+    destination += fragment;
+    M16DownEpilogueBase::reduce(peer_begin, peer_end, fragment, workspace, op,
+                               gate, destination, source, tensor, problem, offset);
+  }
+};
+
+using M16DownGemm = cutlass::gemm::device::GemmUniversalBase<
+    cutlass::gemm::kernel::GemmStreamkWithFusedEpilogue<
+        M16DownDefaults::GemmKernel::Mma, M16DownEpilogue,
+        cutlass::gemm::threadblock::ThreadblockSwizzleStreamK>>;
+
+M16DownGemm::Arguments m16_down_arguments(
+    const void* a, const void* b, const void* gate, void* output) {
+  M16DownGemm::Arguments args;
+  args.problem_size = {50, 1024, 4096};
+  args.ptr_A = a;
+  args.ptr_B = b;
+  args.ptr_C = output;
+  args.ptr_D = output;
+  args.ptr_Vector = const_cast<void*>(gate);
+  args.lda = 4096;
+  args.ldb = args.ldc = args.ldd = 1024;
+  args.ldr = 0;
+  return args;
+}
+
