+// Lab-only ABI for the sole M50 K4096 N1024 candidate; no production route.
+extern "C" int64_t expert_m16_down_workspace() {
+  return static_cast<int64_t>(M16DownGemm::get_workspace_size(
+      m16_down_arguments(nullptr, nullptr, nullptr, nullptr)));
+}
+
+extern "C" int32_t expert_m16_down_plan(
+    const void* a, const void* b, const void* gate, void* output,
+    void* workspace, void* stream, void** handle) {
+  const auto args = m16_down_arguments(a, b, gate, output);
+  cutlass::Status status = M16DownGemm::can_implement(args);
+  if (status != cutlass::Status::kSuccess)
+    return kCutlassError + static_cast<int32_t>(status);
+  auto* plan = new M16DownGemm;
+  status = plan->initialize(args, workspace, static_cast<cudaStream_t>(stream));
+  if (status != cutlass::Status::kSuccess) {
+    delete plan;
+    return kCutlassError + static_cast<int32_t>(status);
+  }
+  *handle = plan;
+  return 0;
+}
+
+extern "C" int32_t expert_m16_down_run(void* handle, void* stream) {
+  const cutlass::Status status =
+      static_cast<M16DownGemm*>(handle)->run(static_cast<cudaStream_t>(stream));
+  if (status != cutlass::Status::kSuccess)
+    return kCutlassError + static_cast<int32_t>(status);
+  return static_cast<int32_t>(cudaGetLastError());
+}
+
+extern "C" void expert_m16_down_destroy(void* handle) {
+  delete static_cast<M16DownGemm*>(handle);
+}
