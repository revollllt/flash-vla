    "stream": {
      "tag": "ld.bw.dev.dram",
      "value": 1.524,
      "units": "MB per us marginal (1.598 TB/s, 89% of the 1.792 TB/s datasheet peak) behind 3.35 us of fixed cost, fitted over 16-128 MB as a 1-node CUDA graph replay with L2 flushed outside the timed region. Launching the same kernel from a stream instead fits 3.93 + MB/1.539, agreeing within the 6% noise floor -- this fixed cost is the memory system's own spin-up, NOT launch overhead, because an event pair around a launch measures GPU-side kernel duration",
      "short": "3.35us + MB/1.524",
      "fixed_us": 3.35
    },
    "tensor": {
      "tag": "mma.tflops.dev.bf16",
      "value": 253,
      "units": "TFLOP/s bf16 with fp32 accumulate, sustained across the whole device, from wall time rather than a clock assumption; 248.8 at 4 warps per SM rising to 253.2 at 12, register-resident operands. This is mma.rate.sm.bf16's 512 FLOP/cycle/SM at the 2.89 GHz this part was observed running (mma.clock.sm), and the two must move together",
      "short": "253 TFLOP/s observed"
    },
    "launch": {
      "tag": "launch.lat.dev.ramp",
      "value": 0.45,
      "units": "us per launch INSIDE a CUDA graph, 256 threads, from a 64-node graph replayed under one event pair; 0.419 at 1 CTA, 0.449 at 170, 0.515 at 340, 0.802 at 1024 -- so unlike a stream launch it does rise with grid size. The same empty kernel launched back-to-back from a STREAM costs 2.05 us and is flat in grid size, the fixed submission cost hiding the ramp",
      "short": "0.45 us/launch in-graph (2.05 in-stream)"
    },
    "knee": {
      "tag": "ld.ctas.dev.knee",
      "value": 340,
      "units": "CTAs at which a cold 16 MB read reaches its best time (14.34 us); exactly 2x the 170 SMs, and flat from there to 2720",
      "short": "knee @ 2x SM count"
    }
  },
