{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flash-vla/target-onboarding/v2",
  "title": "Flash-VLA architecture-aware Target onboarding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "performance_objective",
    "correctness_requirements",
    "benchmark_protocol",
    "deployment_bound",
    "optimization_budget",
    "assumptions",
    "version",
    "target",
    "initial_weights",
    "execution_variant",
    "reference",
    "deployment"
  ],
  "properties": {
    "performance_objective": {
      "type": "object",
      "required": [
        "metric",
        "direction",
        "unit"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "correctness_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "benchmark_protocol": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deployment_bound": {
      "type": "object",
      "required": [
        "metric",
        "comparator",
        "value",
        "unit"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "comparator": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "optimization_budget": {
      "type": "object",
      "required": [
        "candidates",
        "non_improving",
        "jobs"
      ],
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 1
        },
        "non_improving": {
          "type": "integer",
          "minimum": 1
        },
        "jobs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "version": {
      "const": 2
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "hardware",
        "model",
        "model_revision",
        "inference_signature",
        "shape"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "hardware": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "inference_signature": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "initial_weights": {
      "type": "object",
      "required": [
        "checkpoint_id",
        "checkpoint_digest"
      ],
      "properties": {
        "checkpoint_id": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_digest": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantization",
        "cache"
      ],
      "properties": {
        "quantization": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "cache": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deployment": {
      "type": "string",
      "minLength": 1
    }
  }
}
